{
  "name": "nessy-orch",
  "version": "2.0.0",
  "description": "Оркестратор nessy: мультиспейсы, граф агентов, общая лента, HTTP/SSE API и CLI",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nessy-orch": "bin/nessy-orch",
    "nessy-orch-v2": "bin/nessy-orch-v2"
  },
  "scripts": {
    "build": "npm run build:server",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:server": "npm run clean && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "cli-v2": "node dist/src/interfaces/cli-v2/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"shared/**/*.ts\" \"test/**/*.ts\"",
    "lint:format": "prettier --check \"src/**/*.ts\" \"shared/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build:server && node --test --test-force-exit \"dist/test/**/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run lint:format && npm test",
    "start": "npm run build && node dist/src/main.js",
    "demo": "npm run build && export NESSY_ORCH_HOME=${TMPDIR:-/tmp}/nessy-orch-demo ORCH_AUTO_APPROVE=0 NESSY_BIN=$PWD/dist/test/support/fake-nessy.js && (node scripts/demo-seed.mjs &) && node dist/src/main.js",
    "demo:seed": "NESSY_ORCH_HOME=${TMPDIR:-/tmp}/nessy-orch-demo node scripts/demo-seed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@nestor/nessy-cli-sdk": "0.8.6"
  }
}
