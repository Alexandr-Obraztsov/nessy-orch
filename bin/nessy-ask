#!/usr/bin/env node
'use strict';
// Совместимость: nessy-ask <cwd> "<промпт>" [--bg]  →  nessy-orch ask / spawn
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const args = process.argv.slice(2);
const bg = args.includes('--bg');
const rest = args.filter((a) => a !== '--bg');
if (rest.length < 2) {
  process.stderr.write('usage: nessy-ask <cwd> "<промпт>" [--bg]\n(устарело: используйте nessy-orch ask|spawn)\n');
  process.exit(2);
}
const [cwd, ...prompt] = rest;
const cli = path.join(__dirname, 'nessy-orch');
const a = bg ? ['spawn', '--space', path.resolve(cwd), prompt.join(' ')] : ['ask', path.resolve(cwd), prompt.join(' ')];
process.exit(spawnSync(process.execPath, [cli, ...a], { stdio: 'inherit' }).status ?? 1);
