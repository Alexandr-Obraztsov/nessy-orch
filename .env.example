# Скопируйте в ~/.nessy-orch/.env (или в .env в корне проекта) и заполните.
# Оркестратор читает файл при старте и передаёт переменные дочерним nessy serve.
# Переменные, уже заданные в окружении, имеют приоритет.

# токен nessy serve: если задан, serve требует Authorization: Bearer (оркестратор его передаёт)
NESSY_SERVER_TOKEN=

# при необходимости — прокси и корпоративные сертификаты для nessy
# HTTPS_PROXY=http://proxy.example:3128
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem
