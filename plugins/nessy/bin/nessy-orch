#!/usr/bin/env node
'use strict';
// CLI оркестратора внутри плагина nessy: Claude Code кладёт bin/ плагина в PATH инструмента Bash.
// Собранный CLI лежит рядом (dist/ — его кладёт сборка приложения); в репозитории — в корне проекта.
const path = require('node:path');
const fs = require('node:fs');
const rel = path.join('dist', 'src', 'interfaces', 'cli', 'main.js');
const candidates = [path.join(__dirname, '..', rel), path.join(__dirname, '..', '..', '..', rel)];
const entry = candidates.find(p => fs.existsSync(p));
if (!entry) {
  process.stderr.write('nessy-orch: CLI не найден. Установите плагин через приложение TClaude-Orch или соберите проект: npm install && npm run build\n');
  process.exit(1);
}
require(entry);
